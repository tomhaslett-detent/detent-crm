{
  "name": "TeamInvite",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Work email the invitation was sent to"
    },
    "crm_role": {
      "type": "string",
      "enum": [
        "admin",
        "revops",
        "manager",
        "rep",
        "service",
        "viewer"
      ],
      "default": "rep"
    },
    "crm_team": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked"
      ],
      "default": "pending"
    },
    "invited_by": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}